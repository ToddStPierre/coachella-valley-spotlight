rules_version = '2';
// Coachella Valley Spotlight. Each signed-in user can read and write only their own users/{uid} document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'favorites', 'prefs', 'updatedAt'])
        && request.resource.data.favorites is list && request.resource.data.favorites.size() <= 500
        && request.resource.data.prefs is map && request.resource.data.prefs.keys().hasOnly(['news', 'deals', 'events']);
    }
  }
}
